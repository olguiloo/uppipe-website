{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "resumen.uppipe.co"
        }
      ],
      "destination": "/resumen.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "summary.uppipe.co"
        }
      ],
      "destination": "/summary.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "crew.uppipe.co"
        }
      ],
      "destination": "/crew.html"
    }
  ],
  "redirects": [
